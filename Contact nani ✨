        function openLightbox(id) {
            const item = photosData.find(p => p.id === id);
            if (!item) return;

            currentActiveItem = item;

            // Fill Modal Details
            document.getElementById('modalTitle').textContent = item.title;
            document.getElementById('modalCategory').textContent = item.categoryLabel;
            document.getElementById('modalDate').textContent = item.date;
            document.getElementById('modalDescription').textContent = item.desc;
            
            // Set Modal Image Graphic
            const svgContainer = document.getElementById('modalImageSvgContainer');
            svgContainer.className = "w-full h-full min-h-[300px] flex flex-col items-center justify-center p-8 transition-colors";
