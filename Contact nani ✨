        function toggleLike(id) {
            const item = photosData.find(p => p.id === id);
            if (!item) return;

            item.liked = !item.liked;
            item.likes += item.liked ? 1 : -1;

            const icon = document.getElementById(`likeIcon-${id}`);
            const count = document.getElementById(`likeCount-${id}`);

            if (icon && count) {
                icon.className = `${item.liked ? 'fa-solid text-rose-500' : 'fa-regular'} fa-heart text-sm`;
                count.textContent = item.likes;
            }

            if (currentActiveItem && currentActiveItem.id === id) {
                updateModalLikeUI();
            }
        }

